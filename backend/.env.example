PORT=5001
NODE_ENV=development
# Public URL of the app (used for OAuth callbacks) and allowed browser origins
PUBLIC_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001

# AI assistant (Gemini). Without a key, answers come from the rule-based engine.
GEMINI_API_KEY=
# Or use OpenRouter instead (an sk-or- key in GEMINI_API_KEY also works)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# Google sign-in: OAuth 2.0 Web Client ID from Google Cloud Console (not an API key)
GOOGLE_CLIENT_ID=

# Zerodha Kite Connect (holdings sync). Redirect URL: <PUBLIC_URL>/api/portfolio/connections/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Security. Both are auto-generated on first run if empty; set them explicitly in production.
# DATA_ENCRYPTION_KEY: 64 hex chars (AES-256-GCM key for the data store)
DATA_ENCRYPTION_KEY=
TOKEN_SECRET=
SESSION_IDLE_HOURS=24
SESSION_MAX_DAYS=14

# Storage and Python
DATA_FILE=
PYTHON_PATH=python3
